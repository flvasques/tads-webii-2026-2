{
  "name": "aula08-cadastro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aula 08 - API de cadastro com verificação de e-mail em arquitetura hexagonal, com duas estratégias de envio (console e Nodemailer).",
  "scripts": {
    "dev": "tsx src/index.ts",
